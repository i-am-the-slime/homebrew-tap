seed 1

scene setup {
  + client: Client
  + api: API
  + db: Database
  + client -> api
  + api -> db
}

scene "direct read" {
  client ~> api: GET /user/42
  api ~> db: SELECT
}

scene "introduce cache" {
  + cache: Cache
  - api -> db
  + api -> cache
}

scene "cache hit" {
  client ~> api: GET /user/42
  api ~> cache: HIT
}

scene "introduce queue" {
  + queue: Queue
  + api -> queue
}

scene publish {
  client ~> api: POST /order
  api ~> queue: publish
}
